# Copie para .env (desenvolvimento) e configure as MESMAS chaves na Vercel (Preview/Production).
# NUNCA publique valores reais. Gere segredos com:  openssl rand -base64 32

# Connection string do Neon (Vercel Marketplace injeta DATABASE_URL automaticamente). Use sslmode=require.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require

# Assinatura do JWT do painel (mínimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres

# AES-256-GCM para CPF/telefone: exatamente 32 bytes em base64  (openssl rand -base64 32)
FIELD_ENCRYPTION_KEY=
# Pepper do HMAC usado para localizar CPF sem guardá-lo em claro  (openssl rand -base64 32)
HASH_PEPPER=

# URL pública do app (vai dentro do QR Code). Em produção: https://seu-dominio.com
APP_BASE_URL=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo
SESSION_TTL_HOURS=6

# Somente para scripts/create-admin.js
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Chave de uso único para criar o primeiro administrador pelo site (/setup). 16+ caracteres.
# Depois de criar o admin, pode remover esta variável da Vercel.
SETUP_TOKEN=
